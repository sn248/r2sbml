# libsbml is downloaded, patched and built from source by tools/cmake_call.sh
# on every install, so none of these are authored by this package.  libsbml-src
# and libsbml-build are normally removed by that script's EXIT trap but survive
# an interrupted build; libsbml-install is the cmake install prefix.
src/libsbml-src/
src/libsbml-build/
src/libsbml-install/
src/libsbml-*.tar.gz

